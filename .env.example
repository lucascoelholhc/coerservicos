# Copie para .env (que não vai para o git) e preencha.

# ---- JWT (obrigatório: sem isso a aplicação não sobe) ------------------------
# Gere uma chave com: openssl rand -base64 32   (ou: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
# Para trocar a chave: novo kid em COE_JWT_KID_ATUAL e mantenha o anterior na lista por pelo menos 20 min
# (15 min de validade + 30 s de tolerância, com folga).
COE_JWT_KID_ATUAL=local-1
COE_JWT_CHAVES=local-1:

# ---- Códigos SMS (obrigatório) -----------------------------------------------
# Chave do HMAC dos códigos, diferente da do JWT (base64 de 32 bytes, gere como acima).
COE_CHAVE_CODIGOS=

# ---- Criptografia de campo (obrigatório) ------------------------------------
# CPF, chave Pix e endereço em AES-256-GCM. Chave de 32 bytes em base64 (gere como acima).
# Rotação: nova chave com kid novo em COE_CIFRA_KID_ATUAL; mantenha a anterior na lista até cifrar tudo de novo.
COE_CIFRA_KID_ATUAL=local-1
COE_CIFRA_CHAVES=local-1:
# HMAC do CPF (unicidade sem expor o número): chave própria, diferente das de cifra. Trocar = recalcular os hashes.
COE_CHAVE_HMAC_CPF=

# ---- Gateway de pagamento (DOM-07) -------------------------------------------
# No perfil local o gateway é FALSO e o token do webhook já vem no application-local.yml.
# Em produção (AWS-09): o mesmo token cadastrado no painel do Asaas, 32 caracteres ou mais.
# COE_GATEWAY_TOKEN_WEBHOOK=

# ---- Arquivos (S3 local: SeaweedFS do docker compose) --------------------------
# Obrigatório para o docker compose e para a aplicação no perfil local. Invente os dois valores
# (16 caracteres ou mais; só letras, números e / + = _ -), ex.: openssl rand -hex 16 e openssl rand -base64 30.
# Em produção não há chave: a aplicação usa o papel IAM da tarefa (AWS-04).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Banco ------------------------------------------------------------------
# Postgres instalado na máquina (padrão, porta 5432):
DB_URL=jdbc:postgresql://localhost:5432/coeservicos
# Ou o Postgres do docker-compose (porta 5433):
# DB_URL=jdbc:postgresql://localhost:5433/coeservicos
DB_USER=
DB_PASSWORD=

# Papéis no banco (ver V1__base.sql):
# - O Flyway roda com o usuário DONO do schema.
# - A aplicação deve conectar com um login membro de coe_app (não dono), assim
#   não consegue alterar tabelas, desligar triggers nem apagar o ledger.
#   Ex.: CREATE ROLE coe_app_login LOGIN PASSWORD '...' IN ROLE coe_app;
# - Em produção, defina o dono só para o Flyway pelas variáveis de ambiente
#   SPRING_FLYWAY_USER e SPRING_FLYWAY_PASSWORD, e use DB_USER/DB_PASSWORD
#   com o login da aplicação.
# - No local, usar o mesmo usuário (dono) nos dois funciona, mas sem essa proteção.
